APP_ENV=development
SECRET_KEY=replace-with-a-long-random-development-secret
DATABASE_URL=sqlite:///local.db
# For Docker Compose, DATABASE_URL and REDIS_URL are supplied by compose.
REDIS_URL=
S3_BUCKET=
AWS_REGION=ap-south-1
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/your-community-invite-code
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Now-123456
ADMIN_NAME=Rakshith N
ADMIN_FORCE_CHANGE=0
MAX_UPLOAD_MB=15
MAX_VIDEO_MB=50
MAX_PASSWORD_LENGTH=128
CHAT_SLOW_SECONDS=15
SOCKET_MAX_BUFFER=65536
TRUST_PROXY=0
COOKIE_SECURE=0
CORS_ORIGINS=
TRUSTED_HOSTS=
RATELIMIT_ENABLED=1

# Password reset (AWS production uses SES + ECS task IAM role)
PASSWORD_RESET_EMAIL_FROM=
# Leave blank to build e-mail links from the address people are visiting (works for localhost, tunnels, real domains).
PUBLIC_BASE_URL=
PASSWORD_RESET_TTL=3600
DEV_SHOW_RESET_LINK=1
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000

# Auto-logout after this many seconds (3600 = 1 hour)
SESSION_LIFETIME_SECONDS=3600

# ---- Outgoing e-mail (used for password-reset links) ----
# Gmail: turn on 2-Step Verification, then create an "App Password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SMTP_USE_SSL=0
MAIL_FROM=yourname@gmail.com
# Blank = well-known providers only (gmail.com, yahoo.com, outlook.com, ...). Add more, or * for any domain.
EMAIL_ALLOWED_DOMAINS=

# ---- AI quiz generator (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey and paste it after the = sign. Keep it secret; never commit .env.
# Leave blank to switch AI generation off (quizzes can still be typed by hand and existing quizzes keep working).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=45
QUIZ_MAX_QUESTIONS=20
# 1 = e-mail every active member when a quiz is published (needs the SMTP settings above); 0 = don't
QUIZ_NOTIFY_EMAILS=1
# 1 = e-mail members when the admin posts in the feed or writes/shares a file in the community; 0 = don't
ADMIN_POST_EMAILS=1
